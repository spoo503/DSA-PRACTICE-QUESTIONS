def span_array(arr):
    max,min=0,0
    if arr[0]>arr[1]:
        max,min=arr[0],arr[1]
    else:
        max,min=arr[1],arr[0]
    for i in range(len(arr)):
        if arr[i]>max:
            max=arr[i]
            return max
        elif arr[i]<min:
            arr[i]=min
    return max-min
