def binary_search(a,target):
    target=45
    l,h,m=0,len(a)-1,0
    while(l<=h):
        m=(l+h)//2
        if target==a[m]:
            return m
        elif a[m]<target:
            h=m-1
        else:
            l=m+1
    return -1
