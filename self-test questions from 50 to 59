🔵 Span of Array

1.Find span of [6,3,4,5,2] — span = max - min.
class Solution:
    def span_array(self, arr):
        maximum = arr[0]   # start with first element
        minimum = arr[0]

        for i in range(1, len(arr)):  # check ALL elements
            if arr[i] > maximum:
                maximum = arr[i]
            elif arr[i] < minimum:
                minimum = arr[i]

        return maximum - minimum

s = Solution()
print(s.span_array([6, 3, 4, 5, 2]))
# Output: 4  (6 - 2)
