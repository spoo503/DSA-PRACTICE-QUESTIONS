🔵 Search in Rotated Array

Search 4 in [6,7,1,2,3,4,5].
class Solution:
    def rotate_array(self,num):
        l,h,m=0,len(num)-1,0
        target=4
        while(l<=h):
            m=(l+h)//2
            if target==num[m]:
                return m
            elif num[l]<=num[m]:
                if target>=num[l] and target<num[m]:
                    h=m-1
                else:
                    l=m+1
            else:
                if target<num[h] and target>=num[m]:
                    l=m+1
                else:
                    h=m-1
        return -1
s=Solution()
print(s.rotate_array([6,71,2,3,4,5]))

