class Solution:
    def count_element(self, num):
        l, h = 0, len(num)-1
        target = 5
        res = -1

        while l <= h:
            m = (l + h) // 2
            if num[m] <= target:   # ✅ include equal too
                res = m            # save this position
                l = m + 1          # try to go further right
            else:
                h = m - 1          # too big, go left

        return res + 1             # index + 1 = count

