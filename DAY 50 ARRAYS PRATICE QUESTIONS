1.Two Sum
def two_sum(a,target):
    for i in range(len(a)):
        for j in range(i+1,len(a)):
            if a[i]+a[j]==target:
                return (i,j)
    return -1
def main():
    a=[1,2,3,4,5]
    target=9
    print(two_sum(a,target))
if __name__=='__main__':
    main()
                
