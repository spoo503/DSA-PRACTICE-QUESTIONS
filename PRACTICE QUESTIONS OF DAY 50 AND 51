class Solution:
    def search_insertion(self,a):
        l,h,m=0,len(a)-1,0
        target=76
        while(l<=h):
            m=(l+h)//2
            if target==a[m]:
                return m
            elif target<a[m]:
                h=m-1
            else:
                l=m+1
        return h+1# or we can use return l
