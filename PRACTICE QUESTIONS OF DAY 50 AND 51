4.Sqrt(x).
class Solution:
    def Square_root(self,num):
        l,h,m=0,num,0
        ans=0
        while(l<=h):
            m=(l+h)//2
            if m*m==num:
                return m
            elif m*m<num:
                ans=m
                l=m+1
            else:
                h=m-1
        return ans
