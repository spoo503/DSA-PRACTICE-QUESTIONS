5.Search in Rotated Sorted Array.
class Solution:
    def Rotated_array(self,a):
        l,h,m=0,len(a)-1,0
        target=67
        while(l<=h):
            m=(l+h)//2
            if target==a[m]:
                return a[m]
            elif a[l]<a[m]:
                if a[l] <= target < a[m]:
                    l=m+1
                else:
                    h=m-1
            else:
                if  a[m] < target <= a[h]:
                    l=m+1
                else:
                    h=m-1
        return -1
