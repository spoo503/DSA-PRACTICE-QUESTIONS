3.Valid Perfect Square.
class Solution:
    def perfect_square(self,num):
        l,h,m=0,num,0
        while(l<=h):
            m=(l+h)//2
            if m*m==num:
                return num
            elif m*m<num:
                l=m+1
            else:
                h=m-1
        return False
