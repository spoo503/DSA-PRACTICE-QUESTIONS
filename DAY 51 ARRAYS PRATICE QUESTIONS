1.-------------------------------------------BINARY SEARCH------------------------------------------------------------------------------
class Solution:
    def binary_search(self,a):
        l,h,mid=0,len(a)-1,0
        target=12
        while(l<=h):
            mid=(l+h)//2
            if target==a[mid]:
                return mid
            elif target<a[mid]:
                h=mid-1
            else:
                l=mid+1
        return -1
s=Solution()
print(s.binary_search([12,13,14,15,56]))
2.--------------------------------------------SEARCH-INSERTION-------------------------------------------------------------------------------
class Solution:
    def search_insertion(self,a):
        l,h,mid=0,len(a)-1,0
        target=56
        while(l<=h):
            mid=(l+h)//2
            if target==a[mid]:
                return mid
            elif  target<a[mid]:
                h=mid-1
            else:
                l=mid+1
        a.insert(l,target)
        return a
